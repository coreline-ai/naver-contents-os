{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60
    },
    "sections": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50
          },
          "content": {
            "type": "string",
            "minLength": 80,
            "maxLength": 450
          }
        },
        "required": ["heading", "content"],
        "additionalProperties": false
      }
    },
    "tags": {
      "type": "array",
      "maxItems": 0,
      "items": {"type": "string"}
    },
    "fact_warnings": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 160
      }
    }
  },
  "required": ["title", "sections", "tags", "fact_warnings"],
  "additionalProperties": false
}
