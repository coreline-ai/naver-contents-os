# NAVER API HUB (https://naverapihub.apigw.ntruss.com)
NAVER_HUB_CLIENT_ID=
NAVER_HUB_CLIENT_SECRET=

# NAVER SearchAd (https://api.searchad.naver.com)
NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET_KEY=
NAVER_SEARCHAD_CUSTOMER_ID=

# LLM
# codex_cli   : 공식 Codex CLI의 기존 `codex login`을 재사용하는 고품질 기본 경로
# local       : Ollama. 데이터가 기기 밖으로 나가지 않지만 모델 품질을 별도 검증해야 함
# openai_compat: 사용자가 직접 신뢰하고 설정한 OpenAI 호환 엔드포인트
LLM_PROVIDER=codex_cli

# 공식 Codex CLI (LLM_PROVIDER=codex_cli)
# OAuth token 값이나 ~/.codex/auth.json 경로를 이 파일에 넣지 마세요.
CODEX_CLI_EXECUTABLE=codex
CODEX_CLI_MODEL=gpt-5.6-sol
CODEX_CLI_REASONING=high
CODEX_CLI_TIMEOUT_SECONDS=300

# Ollama (LLM_PROVIDER=local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# OpenAI 호환 엔드포인트 (LLM_PROVIDER=openai_compat 일 때 사용)
OPENAI_COMPAT_BASE_URL=http://127.0.0.1:8787/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Local Core
LOCAL_CORE_HOST=127.0.0.1
LOCAL_CORE_PORT=3719
LOCAL_CORE_TOKEN=
PUBLISHER_CDP_URL=http://127.0.0.1:9222

# Provider 자체 보호 한도 (공식 콘솔 한도보다 보수적으로 설정)
HUB_SEARCH_MONTHLY_LIMIT=50000
HUB_SEARCH_DAILY_LIMIT=10000
HUB_SEARCH_RPS=25
HUB_TREND_MONTHLY_LIMIT=5000
HUB_TREND_DAILY_LIMIT=2000
HUB_TREND_RPS=10
HUB_SHOPPING_MONTHLY_LIMIT=5000
HUB_SHOPPING_DAILY_LIMIT=2000
HUB_SHOPPING_RPS=10
SEARCHAD_MONTHLY_LIMIT=10000
SEARCHAD_DAILY_LIMIT=2000
SEARCHAD_RPS=1
